# Секреты и конфигурация (КРИТИЧЕСКИ ВАЖНО)
.env
.env.*
!.env.example

# Папки виртуального окружения
venv/
env/
.venv/

# Системный кэш Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Настройки редактора кода
.vscode/

# Логи и временные файлы
*.log

# Базы данных (если когда-то будем использовать локальную SQLite)
*.sqlite3
*.db